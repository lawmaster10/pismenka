rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/backups/current {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Refuse schema downgrades and tiny clobbers of substantial backups.
      // This protects even already-shipped older app builds that lack the
      // client-side write guard (the 1.4 → empty overwrite failure mode).
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          !resource.exists
          || (
            request.resource.data.schemaVersion is int
            && resource.data.schemaVersion is int
            && request.resource.data.schemaVersion >= resource.data.schemaVersion
            && !(
              resource.data.payloadBytes is int
              && request.resource.data.payloadBytes is int
              && resource.data.payloadBytes >= 4096
              && request.resource.data.payloadBytes < 1024
            )
          )
        );
    }
  }
}
